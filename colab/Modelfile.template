# Modelfile do leitor ajustado (qwen3-manual:4b).
#
# O Modelfile real é o do leitor base com SÓ a linha FROM trocada: TEMPLATE, PARAMETER e SYSTEM ficam
# idênticos aos do qwen3:4b (chat template do Qwen3, tokens de parada e parâmetros padrão). Gere-o com:
#
#   bash colab/criar_modelo_local.sh models/qwen3-manual-q4_k_m.gguf
#
# que equivale a:
#
#   ollama show qwen3:4b --modelfile | sed 's|^FROM .*|FROM ./models/qwen3-manual-q4_k_m.gguf|' > Modelfile
#   ollama create qwen3-manual:4b -f Modelfile
#   ollama run qwen3-manual:4b "Responda apenas: ok"
#
# Estrutura esperada do arquivo gerado (os blocos vêm da sua versão do Ollama; não os edite à mão):

FROM ./models/qwen3-manual-q4_k_m.gguf
# TEMPLATE """...""" copiado de `ollama show qwen3:4b --modelfile`
# PARAMETER ... copiados de `ollama show qwen3:4b --modelfile`
# SYSTEM ... (se existir no modelo base)
